# ═══════════════════════════════════════════════════
# Resume AI & Placement Platform — Backend Config
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════

# App
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Security
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Admin Seed Credentials (used only by seed.py — not hardcoded in app)
ADMIN_EMAIL=admin@platform.com
ADMIN_PASSWORD=Admin@2026!

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<appname>
MONGO_DB_NAME=resume_ai_platform

# CORS Origins (comma separated, no spaces)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload Config
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# ML
ML_MODEL_PATH=ml/artifacts/resume_job_match_model.joblib
ML_MODEL_VERSION=1.0
